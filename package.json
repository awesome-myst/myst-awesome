{
  "name": "myst-awesome-workspace",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter=myst-awesome dev",
    "build": "pnpm --filter=myst-astro-collections build && pnpm --filter=myst-awesome build && pnpm --filter=myst-awesome-docs build",
    "build-collections": "pnpm --filter=myst-astro-collections build",
    "preview": "pnpm --filter=myst-awesome preview",
    "test": "pnpm --filter=myst-astro-collections test && pnpm --filter=myst-awesome test && pnpm --filter=myst-awesome-docs test",
    "typecheck": "pnpm --filter=myst-astro-collections build && pnpm --filter=myst-awesome typecheck && pnpm --filter=myst-awesome-docs typecheck",
    "start-myst": "pnpm --filter=myst-awesome-docs run myst-content-server",
    "dev-docs": "pnpm --filter=myst-awesome-docs dev",
    "install-all": "pnpm install",
    "check-engines": "node scripts/check-node-engines.mjs",
    "check-deps": "node scripts/check-dependency-policy.mjs",
    "check-webawesome": "node scripts/check-webawesome-registration.mjs",
    "check-scienceicons": "node scripts/check-scienceicons.mjs"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.2"
  },
  "pnpm": {
    "overrides": {
      "@awesome-myst/myst-zod": "0.7.0",
      "astro": "7.3.2",
      "unifont": "0.7.4",
      "@awesome.me/webawesome": "3.12.0",
      "@playwright/test": "1.63.0",
      "mystmd": "1.11.0",
      "myst-common": "1.10.1",
      "myst-parser": "1.7.4",
      "myst-directives": "1.7.4",
      "myst-roles": "1.7.4",
      "myst-transforms": "1.3.51",
      "myst-spec-ext": "1.10.1",
      "sharp": "0.35.4",
      "typescript": "6.0.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
